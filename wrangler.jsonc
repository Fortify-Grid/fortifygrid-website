{
  "name": "fortifygrid-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // fortifygrid.com is public; /dashboard and every app host sit behind Cloudflare Access.
  // workers.dev and preview URLs are off so there is no address that skips Access.
  "routes": [
    { "pattern": "fortifygrid.com", "custom_domain": true },
    { "pattern": "www.fortifygrid.com", "custom_domain": true },
    { "pattern": "app.fortifygrid.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    // Not secrets: Cloudflare puts these in every login token. Filled in by infra/cf-setup.mjs output.
    "CF_ACCESS_TEAM_DOMAIN": "fortifyai.cloudflareaccess.com",
    "CF_ACCESS_AUD": "6631bbc06cd25cc8b4b203b91be81f91481919a8d92705ead6940b29048b70bb,aaa33471e5133335fb1d2d4c9a00e231038e3b54e90f80b076f57db5e93ce539",
    // Always full admins, even before they are in the database. Comma-separated.
    "ADMIN_EMAILS": "krishnan@fortifygrid.com",
    "CF_ACCOUNT_ID": "5b09f3b0f591d77cd46739113e886479",
    // Access group for /dashboard, kept in sync with the user list (every active user). App groups live in D1 apps.
    "PORTAL_GROUP_ID": "6b819b77-5401-469c-b0b4-62139e123936",
    "EMAIL_FROM": "",
    "EMAIL_REPLY_TO": "krishnan@fortifygrid.com"
    // Secrets (npx wrangler secret put …): CF_API_TOKEN (Access: Groups + Apps and Policies edit), EMAIL_API_KEY (optional).
  },
  // App Workers without a public route, reached at app.fortifygrid.com/<app>/ after the role check in worker.js.
  "services": [{ "binding": "IDE", "service": "fortifygrid-ide" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "fortifygrid-portal", "database_id": "e31551d1-1209-4368-ab91-047be118bc45" }
  ],
  "observability": { "enabled": true }
}
